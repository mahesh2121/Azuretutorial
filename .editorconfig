# ╔══════════════════════════════════════════════════════════════════╗
# ║  editorconfig                                                      ║
# ╠══════════════════════════════════════════════════════════════════╣
# ║  Matches tests/test_02_style.py, so an editor cannot introduce a   ║
# ║  style violation that CI then rejects.                              ║
# ╚══════════════════════════════════════════════════════════════════╝
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{tf,hcl,tfvars,tftest.hcl}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
max_line_length = off
