# Local .terraform directory (contains providers and modules)
.terraform/

# .tfstate files (contain sensitive data and shouldn't be in version control)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files by default as they may contain secrets
*.tfvars
*.tfvars.json

# Ignore override files as they are usually for local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you DO wish to add using a negated pattern
# !example_override.tf

# Ignore transient lock info files created during terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc
